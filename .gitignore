# ---- Data (huge: multi-GB DuckDB files are NOT tracked) ----
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.duckdb.old

# Pre-rendered tiles and any staged sample data
tiles/
seadata/

# Raw IQ capture downloads (NIST datasets; rebuild iq.duckdb via iq_ingest.py)
iqdata/

# Default --dest for `atlas.py get` on a remote record
downloads/
*.bak
.fuse_hidden*

# Generated by examples/make_sample.py (regenerate with `python examples/make_sample.py`)
examples/sample_data/

# Local task spec (not part of the published project)
COWORK_TASK.md

# ---- Logs ----
*.log

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- Editor / local tooling ----
.claude/
.vscode/
.idea/

# ---- OS junk ----
Thumbs.db
desktop.ini

# Local copy of the CBRS source CSVs (default SEA_DATA_ROOT)
SEA-DATA/

# Quarantine for cleanup moves (empty this folder to really delete)
_to_delete/

# Fast stat ingest: personal Box tokens + generated file manifest + work dir.
# The .tmp is the file a token refresh writes THROUGH before renaming: a refresh
# that dies between the write and the rename leaves live credentials on disk, and
# `git add -A` would stage them.
ingest/box_tokens.json
ingest/box_tokens.json.tmp
ingest/manifest_stats.json
_stat_build/

# ---- Never publish a database or a working copy again ----
# Every one of these WAS committed and is still live on the remote: a real
# spectrum database, two DuckDB write-ahead logs, and two editor working copies.
# *.bak does not match .bak2, and nothing matched the rest.
*.bak[0-9]
*.unused
*.stale
*.claude-wip
*.orig
*.rej

# Generated by examples/module_map.py --write
docs/MODULE_MAP.md

# ---- More OS junk ----
.DS_Store
nohup.out

# Machine-specific: TRANSFER.md names real drive letters and home paths, so it is
# useful on one disk and noise in the history.
TRANSFER.md
